# Copy to .env and adjust. .env is gitignored; never commit real values.

# CUPS queue name on the host that runs print_brief.ts. Find it with `lpstat -p`.
# Required for real prints; not needed for --dry-run.
# Matt's Mac: Brother HL-L2370DW (mono laser, auto duplex, Letter), the system default queue.
PRINTER_NAME=Brother_HL_L2370DW_series

# Optional: remote CUPS server (host[:port]) if the printer is shared from another machine.
# `lp` reads this natively.
# CUPS_SERVER=

# Optional: extra `lp` options. List what the printer supports with
# `lpoptions -p Brother_HL_L2370DW_series -l`. Use sides=one-sided for single-sided.
# LP_OPTIONS=-o media=Letter -o sides=two-sided-long-edge

# Optional: where rendered text lands (both real and dry runs). Default: out/
# BRIEF_OUT_DIR=out
