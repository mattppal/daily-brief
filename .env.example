# Copy to .env and fill in. .env is gitignored; never commit real values.

# CUPS queue name on the host that runs print_brief.py. Find it with `lpstat -p`.
# Required for real prints; not needed for --dry-run.
PRINTER_NAME=

# Optional: remote CUPS server (host[:port]) if the printer is shared from another machine.
# `lp` reads this natively.
# CUPS_SERVER=

# Optional: extra `lp` options, e.g. paper size, duplex, copies.
# LP_OPTIONS=-o media=Letter -o sides=one-sided

# Optional: where rendered text lands (both real and dry runs). Default: out/
# BRIEF_OUT_DIR=out
